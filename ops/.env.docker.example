# Template for ops/.env.docker, which docker-compose.yml loads into the api
# container with `env_file:`. Copy it and fill in real values:
#
#   cp ops/.env.docker.example ops/.env.docker
#
# ops/.env.docker is gitignored. Never commit it. The values below are
# placeholders, not working secrets.
#
# NODE_ENV=production so local behaviour matches the hosted box (secure
# cookies, https-only webhook URLs, no OTP echo-back). On plain http
# localhost the session cookie won't stick; that's why.
NODE_ENV=production
PORT=3000

# Optional temporary delivery to a private, mounted server file (not stdout).
# Keep OTP_DEV_EXPOSE off. See docs/fixes/operator-otp-file.md.
# OTP_LOG_FILE=/app/private-otp/otp.jsonl

# Shared secret for callbacks from the acquirer (sandbox or live). Get it
# from the acquirer relationship; generate nothing here. The value that used
# to be committed in ops/.env.docker is public and must be rotated.
ACQUIRER_CALLBACK_SIGNING_SECRET=replace-with-the-acquirer-shared-secret
