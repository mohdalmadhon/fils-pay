# The public web server for the hosted box (ops/docker-compose.prod.yml):
# Caddy serving the built merchant dashboard and checkout (apps/web) and
# Ops console (apps/admin), and passing /v1 through to the api. One origin
# per site, so the browser apps call the api with relative paths and no
# cross-site cookies. Caddy gets and renews HTTPS certificates itself.
# Build context is the repo root.

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
RUN npm ci --include=dev --no-audit --no-fund
COPY . .
# Empty API base URLs make both apps call /v1/... on their own origin.
# WEB_BASE_URL is where the Ops console links to the merchant screens.
ARG WEB_BASE_URL=""
ENV VITE_API_BASE_URL="" VITE_ADMIN_API_BASE_URL="" VITE_WEB_BASE_URL=${WEB_BASE_URL}
RUN npm run build -w apps/web && npm run build -w apps/admin

FROM caddy:2.8-alpine
COPY ops/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv/web
COPY --from=build /app/apps/admin/dist /srv/admin
