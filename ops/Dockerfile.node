# Image for the Node services in ops/docker-compose.yml: migrate, seed, api
# and reporting. One image, different `command:` per service. Build context
# is the repo root (`context: ..` in compose).
#
# The services run TypeScript directly with tsx (no build step), so dev
# dependencies are installed too. NODE_ENV is not set here: it comes from
# ops/.env.docker at run time (docs/cyper/03).
FROM node:22-bookworm-slim

WORKDIR /app

# Dependencies first, so source changes don't reinstall them. Every
# workspace's package.json is needed for `npm ci` to resolve the workspace
# graph.
COPY package.json package-lock.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
RUN npm ci --include=dev --no-audit --no-fund && npm cache clean --force

COPY . .

# KYC uploads (KYC_UPLOAD_DIR defaults to ./data/kyc) must be writable by
# the unprivileged user the services run as. Mount a volume here to keep
# uploads across container restarts.
RUN mkdir -p /app/data/kyc && chown -R node:node /app/data

USER node
EXPOSE 3000
CMD ["npx", "tsx", "apps/api/src/index.ts"]
